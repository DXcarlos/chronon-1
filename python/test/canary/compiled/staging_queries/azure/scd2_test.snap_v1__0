  "metaData": {
    "customJson": "{\"airflowDependencies\": [{\"name\": \"wf_default_test_scd2_user_with_offset_0\", \"spec\": \"default.test_scd2_user/record_begin_timestamp={{ macros.ds_add(ds, 0) }}\"}]}",
    "executionInfo": {
