apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../../base

# Pin all Chronon images to the configured tag (images loaded via kind load docker-image)
images:
  - name: chronon-fetcher-k8s
    newTag: "{{ config.images.tag }}"
  - name: chronon-frontend
    newTag: "{{ config.images.tag }}"
  - name: chronon-spark-k8s
    newTag: "{{ config.images.tag }}"
  - name: chronon-spark-base
    newTag: "{{ config.images.tag }}"

# Patches for local development mode
patches:
  # spark-history-server uses chronon-spark-base which must be loaded with Never
  - patch: |-
      - op: replace
        path: /spec/template/spec/containers/0/imagePullPolicy
        value: Never
    target:
      kind: Deployment
      name: spark-history-server
  - patch: |-
      - op: replace
        path: /spec/template/spec/containers/0/imagePullPolicy
        value: IfNotPresent
    target:
      kind: Deployment
      name: hub
  - patch: |-
      - op: replace
        path: /spec/template/spec/containers/0/imagePullPolicy
        value: IfNotPresent
    target:
      kind: Deployment
      name: eval
  - patch: |-
      - op: replace
        path: /spec/template/spec/containers/0/imagePullPolicy
        value: IfNotPresent
    target:
      kind: Deployment
      name: frontend

# Labels specific to local-dev mode (includeSelectors: false avoids immutable selector issues)
labels:
  - pairs:
      app.kubernetes.io/instance: local-dev
    includeSelectors: false
