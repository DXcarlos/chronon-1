# fetcher service deployment
# Provides the Chronon Fetcher API for online feature serving
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fetcher
  namespace: chronon
  labels:
    app: fetcher
spec:
  replicas: 1
  selector:
    matchLabels:
      app: fetcher
  template:
    metadata:
      labels:
        app: fetcher
    spec:
      initContainers:
        - name: wait-for-redis
          image: redis:7-alpine
          command:
            - sh
            - -c
            - |
              until redis-cli -h redis -p 6379 cluster info 2>/dev/null | grep -q "cluster_state:ok"; do
                echo "Waiting for Redis cluster..."
                sleep 2
              done
              echo "Redis cluster is ready"
      containers:
        - name: fetcher
          image: chronon-fetcher-k8s:latest
          imagePullPolicy: {{ pull_policy }}
          command:
            - /bin/sh
            - -c
            - |
              exec java \
                -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5090 \
                -Xms1g \
                -Xmx2g \
{%- if metrics_enabled %}
                -Dai.chronon.metrics.enabled=true \
                -Dai.chronon.metrics.reader=http \
                -Dai.chronon.metrics.exporter.url=http://otel-collector:4318 \
{%- else %}
                -Dai.chronon.metrics.enabled=false \
{%- endif %}
                --add-opens=java.base/java.lang=ALL-UNNAMED \
                --add-opens=java.base/java.lang.invoke=ALL-UNNAMED \
                --add-opens=java.base/java.lang.reflect=ALL-UNNAMED \
                --add-opens=java.base/java.io=ALL-UNNAMED \
                --add-opens=java.base/java.net=ALL-UNNAMED \
                --add-opens=java.base/java.nio=ALL-UNNAMED \
                --add-opens=java.base/java.util=ALL-UNNAMED \
                --add-opens=java.base/java.util.concurrent=ALL-UNNAMED \
                --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED \
                --add-opens=java.base/sun.nio.ch=ALL-UNNAMED \
                --add-opens=java.base/sun.nio.cs=ALL-UNNAMED \
                --add-opens=java.base/sun.security.action=ALL-UNNAMED \
                --add-opens=java.base/sun.util.calendar=ALL-UNNAMED \
                --add-opens=java.security.jgss/sun.security.krb5=ALL-UNNAMED \
                -Dserver.port=9200 \
                -Donline.jar=$ONLINE_JAR \
                -Donline.class=$CHRONON_ONLINE_CLASS \
                -cp "/opt/chronon/service.jar:/opt/chronon/online.jar" \
                ai.chronon.service.ChrononServiceLauncher \
                run "ai.chronon.service.FetcherVerticle"
          ports:
            - containerPort: 9200
              name: http
            - containerPort: 5090
              name: debug
          env:
            - name: CHRONON_EVAL_WAREHOUSE_PATH
              value: "s3a://warehouse/"
            - name: CHRONON_EVAL_WAREHOUSE_CATALOG
              value: "iceberg"
            - name: CHRONON_EVAL_CATALOG_TYPE
              value: "jdbc"
            - name: CHRONON_EVAL_ICEBERG_CATALOG_URI
              value: "jdbc:postgresql://postgres:5432/iceberg_catalog"
            - name: CHRONON_EVAL_ICEBERG_CATALOG_USER
              value: "chronon"
            - name: CHRONON_EVAL_ICEBERG_CATALOG_PASSWORD
              value: "chronon"
            - name: AWS_ACCESS_KEY_ID
              value: "minioadmin"
            - name: AWS_SECRET_ACCESS_KEY
              value: "minioadmin"
            - name: AWS_ENDPOINT_URL
              value: "http://minio:9000"
            - name: AWS_REGION
              value: "us-east-1"
            - name: ONLINE_JAR
              value: "/opt/chronon/online.jar"
            - name: CHRONON_ONLINE_CLASS
              value: "{{ online_class }}"
{% if redis_host %}
            - name: REDIS_HOST
              value: "{{ redis_host }}"
{% endif %}
          resources:
            requests:
              memory: "1Gi"
              cpu: "500m"
            limits:
              memory: "3Gi"
              cpu: "2000m"
          readinessProbe:
            httpGet:
              path: /ping
              port: 9200
            initialDelaySeconds: 10
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /ping
              port: 9200
            initialDelaySeconds: 30
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: fetcher
  namespace: chronon
spec:
  selector:
    app: fetcher
  ports:
    - name: http
      port: 9200
      targetPort: 9200
---
# NodePort service for local access
apiVersion: v1
kind: Service
metadata:
  name: fetcher-nodeport
  namespace: chronon
spec:
  type: NodePort
  selector:
    app: fetcher
  ports:
    - name: http
      port: 9200
      targetPort: 9200
      nodePort: 31999
