# Hub (Orchestration) service deployment
# Provides the Chronon Hub API for workflow orchestration
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hub
  namespace: chronon
  labels:
    app: hub
spec:
  replicas: 1
  selector:
    matchLabels:
      app: hub
  template:
    metadata:
      labels:
        app: hub
    spec:
      initContainers:
        - name: wait-for-postgres
          image: busybox:1.36
          command:
            - sh
            - -c
            - |
              until nc -z postgres 5432; do
                echo "Waiting for PostgreSQL..."
                sleep 2
              done
              echo "PostgreSQL is ready"
      serviceAccountName: spark
      containers:
        - name: hub
          image: chronon-spark-k8s:latest
          imagePullPolicy: {{ pull_policy }}
          command:
            - /bin/sh
            - -c
            - |
              exec java \
                -Dlogback.configurationFile=logback_k8s.xml \
                -Dserver.port=3903 \
                -Ddb.url=jdbc:postgresql://postgres:5432/execution-info \
                -Ddb.username="$DB_USERNAME" \
                -Ddb.password="$DB_PASSWORD" \
                -Dkv.tablePartitionsDataset="$TABLE_PARTITIONS_DATASET" \
                -Dkv.dqMetricsDataset="$DATA_QUALITY_METRICS_DATASET" \
                -cp /opt/chronon/hub.jar \
                ai.chronon.orchestration.service.OrchestratorLauncher \
                run "ai.chronon.hub.K8sOrchestrationVerticle,ai.chronon.hub.K8sWorkflowExecutionVerticle"
          ports:
            - containerPort: 3903
              name: http
          env:
            - name: DB_USERNAME
              valueFrom:
                secretKeyRef:
                  name: postgres-credentials
                  key: hub-db-user
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-credentials
                  key: hub-db-password
            - name: K8S_NAMESPACE
              value: "chronon"
            - name: SPARK_IMAGE
              value: "{{ spark_image }}"
            - name: SPARK_SERVICE_ACCOUNT
              value: "spark"
            - name: SPARK_EVENT_LOG_ENABLED
              value: "true"
            - name: SPARK_EVENT_LOG_DIR
              value: "s3a://chronon-spark-logs/event-logs"
            - name: SPARK_HISTORY_SERVER_URL
              value: "http://spark-history-server:18080"
            - name: CHRONON_ONLINE_CLASS
              value: "{{ online_class }}"
{% if redis_host %}
            - name: REDIS_HOST
              value: "{{ redis_host }}"
{% endif %}
            - name: FLINK_STATE_URI
              value: "s3a://warehouse/flink-state"
            - name: TABLE_PARTITIONS_DATASET
              value: "TABLE_PARTITIONS"
            - name: DATA_QUALITY_METRICS_DATASET
              value: "DATA_QUALITY_METRICS"
          resources:
            requests:
              memory: "512Mi"
              cpu: "250m"
            limits:
              memory: "1Gi"
              cpu: "1000m"
          readinessProbe:
            httpGet:
              path: /ping
              port: 3903
            initialDelaySeconds: 10
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /ping
              port: 3903
            initialDelaySeconds: 30
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: hub
  namespace: chronon
spec:
  selector:
    app: hub
  ports:
    - name: http
      port: 3903
      targetPort: 3903
---
# NodePort service for local access
apiVersion: v1
kind: Service
metadata:
  name: hub-nodeport
  namespace: chronon
spec:
  type: NodePort
  selector:
    app: hub
  ports:
    - name: http
      port: 3903
      targetPort: 3903
      nodePort: 30903
