apiVersion: v1
kind: Service
metadata:
  name: hub
  namespace: chronon
spec:
  type: NodePort
  selector:
    app: hub
  ports:
    - port: 8080
      targetPort: 8080
      nodePort: 30800
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hub
  namespace: chronon
  labels:
    app: hub
spec:
  replicas: 1
  selector:
    matchLabels:
      app: hub
  template:
    metadata:
      labels:
        app: hub
    spec:
      serviceAccountName: spark
      containers:
        - name: hub
          image: chronon-spark-k8s:latest
          imagePullPolicy: {{ pull_policy }}
          ports:
            - containerPort: 8080
          env:
            - name: CHRONON_ONLINE_CLASS
              value: "{{ online_class }}"
            - name: SPARK_IMAGE
              value: "{{ spark_image }}"
            - name: SPARK_MASTER
              value: "k8s://https://kubernetes.default.svc:443"
            - name: SPARK_NAMESPACE
              value: "chronon"
            - name: SPARK_SERVICE_ACCOUNT
              value: "spark"
            - name: MINIO_ENDPOINT
              value: "http://minio:9000"
            - name: MINIO_ACCESS_KEY
              value: "minioadmin"
            - name: MINIO_SECRET_KEY
              value: "minioadmin"
            - name: SPARK_HISTORY_LOG_DIR
              value: "s3a://chronon/spark-logs"
{% if redis_host %}
            - name: REDIS_HOST
              value: "{{ redis_host }}"
            - name: REDIS_PORT
              value: "6379"
{% endif %}
          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 5
