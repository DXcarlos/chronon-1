apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: chronon

# Core infrastructure resources
resources:
  - namespace.yaml
  - spark-rbac.yaml
  - postgres.yaml
  - minio.yaml
  - starrocks.yaml
  - loki.yaml
  - promtail.yaml
  - spark-history-server.yaml
{% if online_store.type == "redis" %}
  - redis.yaml
{% endif %}
{% if otel_file %}
  - {{ otel_file }}
{% endif %}
  - hub.yaml
  - eval.yaml
  - frontend.yaml
  - fetcher.yaml

# Common labels for all resources
labels:
  - pairs:
      app.kubernetes.io/part-of: chronon-quickstart
      app.kubernetes.io/managed-by: kustomize
    includeSelectors: false

# Image references - overlays will customize these
images:
  - name: chronon-spark-base
    newName: chronon-spark-base
    newTag: latest
  - name: chronon-spark-k8s
    newName: chronon-spark-k8s
    newTag: latest
  - name: chronon-frontend
    newName: chronon-frontend
    newTag: latest
