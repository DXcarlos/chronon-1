# OTel Collector exporting to Azure Monitor
# Requires a k8s Secret named {{ observability.azure_connection_string_secret }}
# with key APPLICATIONINSIGHTS_CONNECTION_STRING
apiVersion: v1
kind: ConfigMap
metadata:
  name: otel-collector-config
  namespace: chronon
data:
  otel-collector-config.yaml: |
    receivers:
      otlp:
        protocols:
          grpc:
            endpoint: 0.0.0.0:4317
          http:
            endpoint: 0.0.0.0:4318
    exporters:
      azuremonitor:
        instrumentation_key: ""  # populated via env var
    service:
      pipelines:
        metrics:
          receivers: [otlp]
          exporters: [azuremonitor]
---
apiVersion: v1
kind: Service
metadata:
  name: otel-collector
  namespace: chronon
spec:
  selector:
    app: otel-collector
  ports:
    - name: grpc
      port: 4317
      targetPort: 4317
    - name: http
      port: 4318
      targetPort: 4318
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: otel-collector
  namespace: chronon
spec:
  replicas: 1
  selector:
    matchLabels:
      app: otel-collector
  template:
    metadata:
      labels:
        app: otel-collector
    spec:
      containers:
        - name: otel-collector
          image: otel/opentelemetry-collector-contrib:0.91.0
          args: ["--config=/etc/otel/otel-collector-config.yaml"]
          ports:
            - containerPort: 4317
            - containerPort: 4318
          envFrom:
            - secretRef:
                name: {{ observability.azure_connection_string_secret }}
          volumeMounts:
            - name: config
              mountPath: /etc/otel
      volumes:
        - name: config
          configMap:
            name: otel-collector-config
